<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BYTE & SOL | Comic Universe</title><style>:root{--blue:#19c9ff;--gold:#ffbd35;--bg:#060b1b}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at top,#13285b,var(--bg) 65%);color:white;font:16px system-ui,Arial}header{position:sticky;top:0;z-index:10;background:#070d20e8;backdrop-filter:blur(12px);display:flex;justify-content:space-between;align-items:center;padding:15px 5%;border-bottom:1px solid #345}h1,h2,h3{margin:.3em 0}h1{font-size:clamp(3rem,8vw,7rem);line-height:1;text-shadow:0 0 30px #009cff}h1 span{color:var(--gold)}a,button{cursor:pointer}nav a{color:white;text-decoration:none;margin-left:18px}button{border:0;border-radius:9px;padding:12px 18px;background:var(--blue);font-weight:800;color:#071124}button.alt{background:var(--gold)}button.ghost{background:#1d3153;color:white}.hero{min-height:530px;position:relative;overflow:hidden;display:grid;place-items:center;text-align:center;padding:65px 15px;background:radial-gradient(circle at 20% 50%,#004ca6aa,transparent 40%),radial-gradient(circle at 80% 50%,#e8870d77,transparent 40%)}.hero .copy{z-index:2;pointer-events:none}.hero .copy button{pointer-events:auto;margin:8px}.orb{position:absolute;width:230px;height:290px;display:grid;place-items:center;font-size:8rem;font-weight:1000;border:4px solid;border-radius:45% 45% 35% 35%;box-shadow:0 0 70px currentColor;transition:transform .12s ease-out;opacity:.7}.byte{left:6%;color:var(--blue);transform:rotate(-9deg)}.sol{right:6%;color:var(--gold);transform:rotate(9deg)}section{max-width:1200px;margin:auto;padding:45px 22px}section>p{color:#b4c9e6}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:18px;margin-top:24px}.card{background:linear-gradient(145deg,#1b2c55,#0b132a);border:1px solid #3a5687;border-radius:16px;overflow:hidden;padding-bottom:16px;box-shadow:0 8px 25px #0005}.art{height:260px;display:grid;place-items:center;position:relative;background:radial-gradient(circle,#2461a2,#07142c);overflow:hidden}.art:before{content:'✦';font-size:150px;color:#54cfff66;position:absolute}.art.gold{background:radial-gradient(circle,#a96510,#201126)}.art.gold:before{color:#ffcc5066}.art b{position:relative;font-size:40px;letter-spacing:-2px;text-shadow:0 3px 20px black;transform:rotate(-7deg);text-align:center;padding:12px}.card .info{padding:15px}.card small{color:#9db9d9}.card button{margin:5px 5px 0 0;font-size:12px}.card p{min-height:58px;color:#c7d5e9;font-size:14px}.card.rare{border-color:#d5a135;box-shadow:0 0 22px #d5a13533}.pill{display:inline-block;padding:5px 9px;border-radius:20px;background:#314769;font-size:12px}footer{text-align:center;padding:40px;color:#8ea6c9}dialog{width:min(780px,94vw);max-height:88vh;overflow:auto;background:#101d39;color:white;border:1px solid #4d74b6;border-radius:20px;padding:24px}dialog::backdrop{background:#000b}.panel{min-height:380px;border-radius:12px;padding:45px 25px;display:grid;place-items:center;text-align:center;background:radial-gradient(circle,#275ca4,#090f2a);margin:15px 0}.panel h2{font-size:clamp(2rem,5vw,4rem)}.panel p{font-size:20px;max-width:530px}.toolbar{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between}#promo .art{height:160px}#promo .art b{font-size:24px}@media(max-width:700px){nav a{margin-left:7px;font-size:12px}.orb{width:95px;height:140px;font-size:3rem;opacity:.3}.hero{min-height:430px}}</style></head><body><header><strong style="color:#39caff;font-size:22px">BYTE <span style="color:#ffbf35">& SOL</span></strong><nav><a href="#comics">Comics</a><a href="#cards">Cards</a><a href="#promo">Promos</a></nav></header><div class="hero" id="hero"><div class="orb byte" id="byte">B</div><div class="orb sol" id="sol">S</div><div class="copy"><div class="pill">THE GENESIS COLLECTION • SERIES ONE</div><h1>BYTE <span>& SOL</span></h1><p>Two heroes. Ten adventures. One electrifying universe.</p><button onclick="document.querySelector('#comics').scrollIntoView({behavior:'smooth'})">READ THE COMICS</button><button class="alt" onclick="document.querySelector('#cards').scrollIntoView({behavior:'smooth'})">COLLECT THE CARDS</button></div></div><section id="comics"><h2>📚 Comic Book Library</h2><p>Ten original short digital issues. Read online or save a standard PDF using your browser's Print → Save as PDF option.</p><div class="grid" id="comicGrid"></div></section><section id="cards"><h2>⚡ Collectible Trading Cards</h2><p>Ten original Series One digital card concepts with powers, stats and rarity. Open a card to see its details.</p><div class="grid" id="cardGrid"></div></section><section id="promo"><h2>🚀 20 Promotional Offers</h2><p>Launch campaign concepts for comics, cards, character spotlights and special editions.</p><div class="grid" id="promoGrid"></div></section><section><h2>✨ Rare Edition Supporter Copy</h2><p>Suggested $20 donation for an exclusive gold-themed digital edition. Payments are not enabled yet: connect a verified payment provider before accepting donations or distributing paid copies.</p><button class="alt" onclick="alert('Coming soon! A verified checkout must be connected before donations can be accepted.')">$20 RARE EDITION — COMING SOON</button></section><footer>© BYTE & SOL • Prototype universe • Original stories and concept cards</footer><dialog id="reader"><div class="toolbar"><strong id="readerTitle"></strong><button class="ghost" onclick="document.querySelector('#reader').close()">✕ Close</button></div><div id="pages"></div><div class="toolbar"><button onclick="prevPage()">← Previous</button><span id="counter"></span><button onclick="nextPage()">Next →</button><button class="alt" onclick="window.print()">Save PDF / Print</button></div></dialog><script>const comics=[['The First Spark','An energy experiment connects two strangers.','Byte follows a pulse of impossible code into the abandoned Helios Lab.','Inside, Sol is trying to contain a miniature sun that is breaking free.','Byte redirects the reactor grid while Sol absorbs the escaping light.','The city survives, but a shadowy signal whispers: “Two signatures confirmed.”'],['Glitch City','A virus rewrites the streets.','Traffic lights begin speaking in riddles and buildings flicker like screens.','Byte traces the glitches to a hidden transmitter beneath the city.','Sol powers the failing grid while Byte isolates the corrupted code.','The virus retreats, leaving behind a symbol shaped like a black crown.'],['Solar Storm','Sol discovers the cost of her power.','An unnatural solar storm darkens the sky at noon.','Sol flies into the storm and hears a voice calling her by an unknown name.','Byte builds a magnetic shield as Sol channels the storm away from Earth.','When the clouds clear, Sol’s hands glow with a new, unstable fire.'],['The Shadow Protocol','An invisible hunter pursues Byte.','Byte finds a message in his own handwriting that he never wrote.','A masked duplicate appears on every screen in the city.','Sol sets a trap of pure light while Byte confronts the intruder.','The duplicate escapes with one final warning: “I am your next version.”'],['Beyond the Grid','A doorway opens into the impossible.','A portal appears in the city square, reflecting a world with no horizon.','Byte and Sol cross into a dimension built from forgotten memories.','They free trapped travelers by reconnecting fragments of a broken map.','They return home carrying a key that glows whenever danger approaches.'],['The Battery Wars','A city fights for its last reserves of power.','Every storage tower in the city begins draining at once.','Byte discovers automated drones stealing energy for an unknown master.','Sol restores the hospital network while Byte reprograms the drone swarm.','One captured drone reveals the name of the mastermind: Glitch King.'],['Rise of Dark Byte','The enemy knows every move.','Dark Byte emerges from a fractured mirror of the digital realm.','He predicts Byte’s attacks and turns the city’s defenses against him.','Sol teaches Byte to stop calculating and trust an unpredictable choice.','Dark Byte is defeated for now, but keeps a copy of their secret key.'],['The Last Photon','A dying star sends a plea.','A tiny star falls from the sky and lands in Sol’s hands.','It shows them a distant world losing its last source of warmth.','Byte creates a pathway through space while Sol shares her own energy.','The star reignites, and Sol discovers that hope can travel farther than light.'],['Collision Course','Two realities begin to overlap.','The sky splits and alternate versions of familiar streets appear overhead.','Byte learns that the Genesis Key is pulling two universes together.','Sol holds the fracture open while Byte returns the key to its origin.','The worlds separate, but the Glitch King steps through the closing seam.'],['Genesis: The Awakening','The first saga reaches its climax.','The Glitch King arrives with an army powered by stolen memories.','Byte rallies the city’s inventors while Sol ignites a shield around the skyline.','Together they combine code and sunlight to form the Genesis Pulse.','The king vanishes, the city celebrates, and a new constellation spells: CONTINUE.']];const cards=[['Byte: Origin Form','Common',75,91,'Digital pulse'],['Sol: Origin Form','Common',94,68,'Solar flare'],['Byte: Overclocked','Rare',88,99,'Lightning dash'],['Sol: Supernova','Rare',100,78,'Starburst'],['Dark Byte','Epic',92,96,'Shadow hack'],['Eclipse Sol','Epic',97,87,'Nightfire'],['Byte & Sol: Power Duo','Legendary',100,100,'Fusion strike'],['Glitch King','Legendary',98,95,'Reality rewrite'],['Photon Guardian','Rare',90,82,'Light shield'],['Genesis Fusion','Mythic',100,100,'Genesis pulse']];const promos=['Meet Byte & Sol','Read Issue #001 Free','Collect Series One','Discover the Origin Story','Rare Gold Edition • $20','Unlock the Supernova Card','The Glitch City Adventure','10 Comics to Explore','10 Cards to Collect','The Shadow Protocol','Power Duo Spotlight','Join the Genesis Saga','Explore Beyond the Grid','Battle Dark Byte','The Battery Wars','Meet the Glitch King','The Last Photon','Collision Course','Genesis: The Awakening','The Adventure Continues'];function escapeHTML(s){return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}document.querySelector('#comicGrid').innerHTML=comics.map((c,i)=>`<article class="card"><div class="art ${i%2?'gold':''}"><b>BYTE & SOL<br><small>#${String(i+1).padStart(3,'0')}</small></b></div><div class="info"><small>ISSUE ${String(i+1).padStart(3,'0')}</small><h3>${escapeHTML(c[0])}</h3><p>${escapeHTML(c[1])}</p><button onclick="openComic(${i})">Read Issue</button><button class="ghost" onclick="openComic(${i});setTimeout(()=>window.print(),100)">PDF</button></div></article>`).join('');document.querySelector('#cardGrid').innerHTML=cards.map((c,i)=>`<article class="card ${i>3?'rare':''}"><div class="art ${i%2?'gold':''}"><b>${escapeHTML(c[0])}</b></div><div class="info"><small>CARD ${String(i+1).padStart(3,'0')} • ${c[1]}</small><h3>${escapeHTML(c[0])}</h3><p>Power ${c[2]} · Speed ${c[3]}<br>Signature: ${c[4]}</p><button onclick="alert(${JSON.stringify(c[0]+' | '+c[1]+' | Power '+c[2]+' | Speed '+c[3]+' | '+c[4])})">View Stats</button></div></article>`).join('');document.querySelector('#promoGrid').innerHTML=promos.map((p,i)=>`<article class="card"><div class="art ${i%2?'gold':''}"><b>${escapeHTML(p)}</b></div><div class="info"><small>CAMPAIGN ${String(i+1).padStart(2,'0')}</small><h3>${escapeHTML(p)}</h3></div></article>`).join('');let active=0,page=0;function openComic(i){active=i;page=0;document.querySelector('#readerTitle').textContent=`BYTE & SOL #${i+1}: ${comics[i][0]}`;document.querySelector('#reader').showModal();renderPage()}function renderPage(){let c=comics[active];document.querySelector('#pages').innerHTML=`<div class="panel"><div><small>BYTE & SOL • ISSUE ${active+1} • PAGE ${page+1}</small><h2>${escapeHTML(page===0?c[0]:'✦')}</h2><p>${escapeHTML(page===0?c[1]:c[page+1])}</p></div></div>`;document.querySelector('#counter').textContent=`Page ${page+1} / 5`}function nextPage(){page=Math.min(4,page+1);renderPage()}function prevPage(){page=Math.max(0,page-1);renderPage()}document.querySelector('#hero').addEventListener('pointermove',e=>{let r=e.currentTarget.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;document.querySelector('#byte').style.transform=`translate(${x*45}px,${y*40}px) rotate(-9deg)`;document.querySelector('#sol').style.transform=`translate(${-x*45}px,${-y*40}px) rotate(9deg)`});</script><style>@media print{body>*:not(dialog){display:none!important}dialog{display:block!important;position:static;width:100%;max-height:none;border:0;color:black;background:white}dialog .toolbar{display:none}.panel{background:white;color:black;border:2px solid black;min-height:70vh}}</style></body></html>
