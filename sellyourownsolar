<script>
const FORMSPREE_URL="https://formspree.io/f/mkjjkjzo";

const examples=[
  {
    title:"Chapter 4 · Opening Conversations",
    quote:"Quick question — have you ever compared the cost of solar with what you're paying for electricity now?",
    explanation:"A simple opening designed to identify genuine interest."
  },
  {
    title:"Chapter 4 · Free Proposal Requests",
    quote:"We can start with your name and property address for a preliminary review. To estimate pricing and potential savings accurately, we'll also need your electric usage.",
    explanation:"Start the conversation without presenting an unverified preliminary estimate as a final quote."
  },
  {
    title:"Chapter 5 · Electric Bill Discovery",
    quote:"Do you have a recent electric bill available? That will help us understand your usage and prepare a more useful proposal.",
    explanation:"Ask clearly for the information required to assess a homeowner's needs."
  },
  {
    title:"Chapter 6 · Follow-Up",
    quote:"Hi! Just checking in after our solar discussion. Did you have any questions about the options we reviewed, or would another time work better to go over the details?",
    explanation:"Give the homeowner a clear, low-pressure next step."
  }
];

document.querySelectorAll(".tab").forEach(button=>{
  button.addEventListener("click",()=>{
    const item=examples[Number(button.dataset.example)];
    document.querySelectorAll(".tab").forEach(t=>{
      t.classList.toggle("active",t===button);
    });
    document.getElementById("sample-title").textContent=item.title;
    document.getElementById("sample-quote").textContent='"'+item.quote+'"';
    document.getElementById("sample-explain").textContent=item.explanation;
  });
});

// Install the same functional form in both locations.
document.querySelectorAll(".form-slot").forEach((slot,index)=>{
  const id="order-"+(index+1);
  slot.innerHTML=`
    <form class="order-form" action="${FORMSPREE_URL}" method="POST">
      <input type="hidden" name="product" value="Sell Your Own Solar - Expert Independent Sales Guide">
      <input type="hidden" name="price" value="$19 USD">
      <input type="hidden" name="form_location" value="${index===0?"Middle":"Bottom"}">
      <input type="hidden" name="order_reference" class="order-reference">

      <div class="field">
        <label for="${id}-name">First Name</label>
        <input id="${id}-name" type="text" name="first_name"
          placeholder="Your first name" autocomplete="given-name"
          maxlength="80" required>
      </div>

      <div class="field">
        <label for="${id}-email">Email Address</label>
        <input id="${id}-email" type="email" name="email"
          placeholder="you@example.com" autocomplete="email" required>
      </div>

      <div class="field">
        <label for="${id}-phone">Mobile Phone Number</label>
        <input id="${id}-phone" type="tel" name="phone"
          placeholder="(555) 123-4567" autocomplete="tel"
          minlength="7" maxlength="30" required>
      </div>

      <label class="consent">
        <input type="checkbox" name="sms_consent"
          value="Agreed to order-related text messages" required>
        <span>I agree to receive text messages regarding this purchase
        and payment instructions. Message and data rates may apply.
        No recurring marketing messages are included.</span>
      </label>

      <button class="btn submit" type="submit">
        Request My Copy for $19 →
      </button>

      <div class="status" role="status" aria-live="polite"></div>
      <div class="safe">🔒 No credit card or banking information collected.</div>
    </form>
  `;
});

document.querySelectorAll(".order-form").forEach(form=>{
  form.addEventListener("submit",async event=>{
    event.preventDefault();

    const button=form.querySelector('button[type="submit"]');
    const status=form.querySelector(".status");
    const ref=form.querySelector(".order-reference");

    ref.value="SOL-"+Date.now().toString(36).toUpperCase()
      +"-"+Math.random().toString(36).slice(2,6).toUpperCase();

    button.disabled=true;
    button.textContent="Submitting your request...";
    status.className="status";
    status.textContent="";

    try{
      const response=await fetch(FORMSPREE_URL,{
        method:"POST",
        body:new FormData(form),
        headers:{Accept:"application/json"}
      });

      if(!response.ok)throw new Error("Submission failed");

      form.reset();
      status.className="status success";
      status.textContent="Your order request has been received! We'll contact you by text with payment instructions. Your guide will be emailed after payment is confirmed.";
      button.textContent="Request Submitted";
    }catch(error){
      status.className="status error";
      status.textContent="We couldn't submit your request. Please check your connection and try again.";
      button.disabled=false;
      button.textContent="Request My Copy for $19 →";
    }
  });
});
</script>
